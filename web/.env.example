# SQLite cho dev máy local (không cần cài gì thêm)
DATABASE_URL="file:./dev.db"

# MySQL khi deploy (chạy docker compose up -d ở repo root hoặc dùng dịch vụ managed)
# Lưu ý: đổi provider trong web/prisma/schema.prisma thành "mysql" trước khi migrate
# DATABASE_URL="mysql://phoco:change_me@localhost:3306/game_phoco"

# Mật khẩu đăng nhập /admin
ADMIN_PASSWORD="doi-mat-khau-nay"

# Khóa ký cookie phiên admin — đặt chuỗi ngẫu nhiên dài >= 32 ký tự
SESSION_SECRET="sinh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu"

# URL công khai dùng để sinh mã QR trạm (bắt buộc HTTPS khi ra mắt)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
